---
/**
 * The blog index. Renders the full list when posts exist and the empty state
 * when they don't — no placeholder articles either way.
 */
import { collectTags, getPosts } from '~/lib/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BlogEmptyState from '~/components/blog/BlogEmptyState.astro';
import PostCard from '~/components/blog/PostCard.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Tag from '~/components/ui/Tag.astro';
import { absoluteUrl, breadcrumbSchema } from '~/lib/seo';

const posts = await getPosts();
const tags = collectTags(posts);

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Blog', url: absoluteUrl('/blog') },
  ]),
];
---

<BaseLayout
  title="Blog"
  description="Write-ups on cloud infrastructure, applied machine learning, and building for the web — by SCS Balaji."
  schema={schema}
>
  <PageHeader
    label="Writing"
    title="Notes from the work"
    intro={
      posts.length > 0
        ? 'Write-ups on the problems that took longer than expected — what broke, what I tried, and what finally worked.'
        : undefined
    }
  />

  <div class="shell py-16 sm:py-20">
    {
      posts.length > 0 ? (
        <div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
          <div class="lg:col-span-9">
            <div class="border-t border-line">
              {posts.map((post) => (
                <PostCard post={post} as="h2" />
              ))}
            </div>
          </div>

          {tags.length > 0 && (
            <aside class="lg:col-span-3">
              <h2 class="mono-label text-ink-3">Topics</h2>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {tags.map(({ tag, count }) => (
                  <li>
                    <Tag>
                      {tag}
                      <span class="ml-1.5 text-ink-3">{count}</span>
                    </Tag>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>
      ) : (
        <BlogEmptyState />
      )
    }
  </div>
</BaseLayout>
