---
/**
 * Education. Deliberately the quietest content section on the page: a plain
 * hairline table, no rail, no nodes, no accent — it sits below Projects and
 * Experience in the hierarchy and should read that way.
 */
import { education } from '~/data/education';
import { formatRange } from '~/lib/format';
import Section from '~/components/ui/Section.astro';
---

<Section id="education" index="04" label="Education" title="Where I studied">
  <ul class="border-t border-line">
    {
      education.map((entry) => (
        <li class="border-b border-line py-6" data-reveal>
          <div class="grid gap-x-10 gap-y-2 lg:grid-cols-12">
            <p class="mono-label text-ink-3 whitespace-nowrap lg:col-span-3">
              {formatRange(entry.start, entry.end)}
            </p>

            <div class="lg:col-span-9">
              <h3 class="text-subheading text-ink">{entry.institution}</h3>

              <p class="mt-1 text-meta text-ink-2">
                {entry.qualification}
                {entry.field && <span class="text-ink-3"> · </span>}
                {entry.field}
                {entry.location && (
                  <>
                    <span class="text-ink-3"> · </span>
                    {entry.location}
                  </>
                )}
              </p>

              {entry.detail && (
                <p class="mt-3 text-meta text-ink-3 measure">{entry.detail}</p>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
