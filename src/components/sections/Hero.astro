---
/**
 * Hero. Deliberately not a card and not centred: a wide type column on the
 * left, a mono focus ledger on the right, engineering-paper texture fading out
 * behind both.
 */
import { site } from '~/data/site';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import StatusDot from '~/components/ui/StatusDot.astro';
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-texture grid-texture" aria-hidden="true"></div>

  <div class="shell relative pt-20 pb-section sm:pt-28">
    <div class="grid gap-x-10 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        {
          site.status.active && (
            <div data-reveal>
              <StatusDot label={site.status.label} tone="positive" />
            </div>
          )
        }

        <h1
          id="hero-title"
          class="mt-7 text-display text-ink"
          data-reveal
          style="--reveal-delay: 60ms"
        >
          <span class="block text-ink-3">{site.hero.greeting}</span>
          <span class="mt-2 block">{site.hero.headline}</span>
        </h1>

        <p
          class="mt-8 text-lead text-ink-2 measure"
          data-reveal
          style="--reveal-delay: 140ms"
        >
          {site.hero.description}
        </p>

        <div
          class="mt-10 flex flex-wrap items-center gap-3"
          data-reveal
          style="--reveal-delay: 200ms"
        >
          <Button href="#work" variant="primary" size="md" iconRight="arrow-down">
            View selected work
          </Button>
          <Button href={site.resume} variant="secondary" size="md" iconLeft="download">
            Résumé
          </Button>
          <Button href="#contact" variant="ghost" size="md">Get in touch</Button>
        </div>
      </div>

      <div
        class="lg:col-span-4 lg:col-start-9 lg:pt-4"
        data-reveal
        style="--reveal-delay: 260ms"
      >
        <h2 class="mono-label text-ink-3">Focus</h2>

        <ul class="mt-6 border-t border-line">
          {
            site.focus.map((area, i) => (
              <li class="focus-row flex items-baseline gap-4 border-b border-line py-3.5">
                <span class="mono-meta text-ink-3 tabular-nums">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-meta text-ink-2">{area}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-6 flex items-start gap-2.5 text-micro text-ink-3 measure-tight">
          <Icon name="pin" size={14} class="mt-0.5 shrink-0" />
          {site.location} · {site.timezone}
        </p>

        <p class="mt-3 text-micro text-ink-3 measure-tight">{site.hero.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Texture fades outward from the top-left so it never fights the first
     section's hairline. Masked rather than gradient-filled, so one rule covers
     both themes. */
  .hero-texture {
    position: absolute;
    inset: 0;
    -webkit-mask-image: radial-gradient(120% 90% at 22% 0%, #000 0%, transparent 72%);
    mask-image: radial-gradient(120% 90% at 22% 0%, #000 0%, transparent 72%);
    pointer-events: none;
  }

  .focus-row {
    transition: border-color 0.25s ease;
  }

  .focus-row:hover {
    border-bottom-color: var(--line-strong);
  }
</style>
