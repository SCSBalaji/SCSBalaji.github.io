---
/**
 * Typography for rendered markdown. Written as scoped CSS with `:global()`
 * because `<Content />` output isn't visible to Astro's scoping, and because a
 * typography plugin would be more surface than this site needs.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    color: var(--ink-secondary);
    font-size: 1.0625rem;
    line-height: 1.72;
    max-width: 68ch;
  }

  /* --- Flow: space comes from the top of each block, so the first child
         never adds a stray gap. --- */
  .prose :global(> * + *) {
    margin-top: 1.35em;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.02em;
    scroll-margin-top: 6rem;
  }

  .prose :global(> h2) {
    margin-top: 2.75em;
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .prose :global(> h3) {
    margin-top: 2.25em;
    font-size: 1.1875rem;
    line-height: 1.35;
  }

  .prose :global(> h4) {
    margin-top: 2em;
    font-size: 1.0625rem;
  }

  /* Anchor links generated by Astro's heading IDs. */
  .prose :global(h2 > a),
  .prose :global(h3 > a),
  .prose :global(h4 > a) {
    color: inherit;
    text-decoration: none;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .prose :global(a:hover) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.35rem;
  }

  .prose :global(ul) {
    list-style: none;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 0.5em;
  }

  .prose :global(ul > li) {
    position: relative;
  }

  .prose :global(ul > li)::before {
    content: "";
    position: absolute;
    left: -1.05rem;
    top: 0.7em;
    width: 5px;
    height: 1px;
    background-color: var(--line-strong);
  }

  .prose :global(ol > li::marker) {
    color: var(--ink-muted);
    font-size: 0.875em;
  }

  .prose :global(blockquote) {
    border-left: 1px solid var(--accent);
    padding-left: 1.5rem;
    color: var(--ink);
    font-size: 1.125rem;
    line-height: 1.6;
    letter-spacing: -0.012em;
  }

  .prose :global(blockquote p + p) {
    margin-top: 0.9em;
  }

  .prose :global(hr) {
    margin-block: 3em;
    border: 0;
    border-top: 1px solid var(--line);
  }

  /* --- Code --- */
  .prose :global(code) {
    font-family: var(--font-code), ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875em;
    font-variant-ligatures: none;
  }

  .prose :global(:not(pre) > code) {
    background-color: var(--canvas-sunken);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.1em 0.35em;
    color: var(--ink);
  }

  .prose :global(pre) {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
    tab-size: 2;
  }

  .prose :global(pre code) {
    font-size: inherit;
  }

  /* --- Media --- */
  .prose :global(img),
  .prose :global(video) {
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .prose :global(figcaption) {
    margin-top: 0.75rem;
    font-family: var(--font-code), ui-monospace, monospace;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  /* --- Tables --- */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 0.75rem;
    text-align: left;
  }

  .prose :global(th) {
    color: var(--ink);
    font-weight: 600;
  }
</style>
